# Credenciales de Gmail
EMAIL=tu_correo@gmail.com
APP_PASSWORD=tu_contrasena_de_aplicacion

# Cantidad máxima de correos procesados por ejecución
EMAIL_PROCESSING_LIMIT=10

# Podés dejarla vacía. En ese caso se utilizará automáticamente:
# C:\Users\<usuario_actual>\Documents\Facturas
#
# Ejemplo personalizado:
# SAVE_FOLDER=C:\Users\piola\Documents\Facturas
SAVE_FOLDER=

# Nivel mínimo guardado en el archivo de log.
# Valores admitidos: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Carpeta de logs. Si queda vacía, se usa <proyecto>/logs.
LOG_FOLDER=

# Base SQLite que recuerda qué correos ya fueron revisados.
# Si queda vacía, se usa <proyecto>/data/project_state.sqlite3.
STATE_DB_PATH=

# OCR opcional para PDFs escaneados.
# Si Tesseract está instalado en la ruta estándar de Windows, puede dejarse vacío.
# Si usa otra ubicación, apunte a la carpeta "tessdata".
# Ejemplo:
# OCR_TESSDATA_PATH=C:\Program Files\Tesseract-OCR\tessdata
OCR_TESSDATA_PATH=

# Ruta opcional al ejecutable de Tesseract para OCR de rescate.
# Ejemplo Windows:
# OCR_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TESSERACT_PATH=
